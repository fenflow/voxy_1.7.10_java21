#version 460 core
layout(local_size_x=16,local_size_y=16) in;
layout(binding=0) uniform sampler2D sourceDepth;
layout(r32f,binding=0) writeonly uniform image2D nearMask;
void main() {
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(pixel,imageSize(nearMask))))return;
    imageStore(nearMask,pixel,vec4(texelFetch(sourceDepth,pixel,0).r));
}
